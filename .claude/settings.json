{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-edit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm run *)",
      "Bash(npm run *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(vercel)",
      "Bash(vc)",
      "Bash(git push --tags:*)",
      "Bash(git push --mirror:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git * push *)",
      "Bash(pnpm *vercel*)",
      "Bash(gh pr create:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release upload:*)",
      "Bash(vercel:*)",
      "Bash(vc:*)",
      "Bash(npx *vercel*)"
    ]
  }
}
